ADMIN_USERNAME=admin
ADMIN_PASSWORD=DeinSicheresPasswort123!
# Sicherer als ADMIN_PASSWORD: ADMIN_PASSWORD_HASH benutzen.
# Hash erzeugen mit: node -e "const bcrypt=require('bcryptjs'); console.log(bcrypt.hashSync('DEIN_PASSWORT', 12));"
# ADMIN_PASSWORD_HASH=$2a$12$...
# Mehrere Admins sicher: ADMINS_HASHED=admin:$2a$12$...,max:$2a$12$...
# Alte einfache Variante funktioniert weiter, ist aber weniger sicher: ADMINS=admin:passwort,max:passwort2

SESSION_SECRET=ein-langer-zufaelliger-geheimer-text-123456789
PORT=3000
NODE_ENV=development
MAINTENANCE_MODE=false
MAX_BACKUPS=50

MAIL_ENABLED=false
# E-Mail-Versand über Resend API. Funktioniert auf Render Free besser als SMTP.
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
# Wichtig: Für eigene Absenderdomain muss die Domain in Resend verifiziert sein.
RESEND_FROM=GrünWerk Gartenbau <kontakt@deine-domain.de>
# Alternativ wird MAIL_FROM verwendet, falls RESEND_FROM leer ist.
MAIL_FROM=GrünWerk Gartenbau <kontakt@deine-domain.de>
ADMIN_EMAIL=deine-admin-email@example.com

# Optional: Zeitlimit und automatische Wiederholung für API-Versand
MAIL_TIMEOUT_MS=30000
MAIL_RETRY_ATTEMPTS=3

# PostgreSQL-Datenbank auf Render.
# Lokal leer lassen = es wird weiter data/anfragen.json benutzt.
# Online bei Render als Environment Variable setzen.
DATABASE_URL=postgresql://user:password@host:5432/database

# Admin-Rollen / User-Verwaltung
# Online mit PostgreSQL werden die Admins in der Tabelle admin_users gespeichert.
# Beim ersten Start werden ADMIN_USERNAME/ADMIN_PASSWORD oder ADMINS automatisch als erste User übernommen.
# Rollen: owner, admin, mitarbeiter
# owner = User verwalten + volle Rechte
# admin = Anfragen bearbeiten/löschen + Backups herunterladen
# mitarbeiter = Anfragen sehen + Status ändern

# Foto-Uploads
# Maximal erlaubte Größe pro Bild in MB. Standard: 5
MAX_PHOTO_SIZE_MB=5
