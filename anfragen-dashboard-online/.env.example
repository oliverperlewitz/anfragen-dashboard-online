ADMIN_USERNAME=admin
ADMIN_PASSWORD=DeinSicheresPasswort123!
# Sicherer als ADMIN_PASSWORD: ADMIN_PASSWORD_HASH benutzen.
# Hash erzeugen mit: node -e "const bcrypt=require('bcryptjs'); console.log(bcrypt.hashSync('DEIN_PASSWORT', 12));"
# ADMIN_PASSWORD_HASH=$2a$12$...
# Mehrere Admins sicher: ADMINS_HASHED=admin:$2a$12$...,max:$2a$12$...
# Alte einfache Variante funktioniert weiter, ist aber weniger sicher: ADMINS=admin:passwort,max:passwort2

SESSION_SECRET=ein-langer-zufaelliger-geheimer-text-123456789
PORT=3000
NODE_ENV=development
MAINTENANCE_MODE=false
MAX_BACKUPS=50

MAIL_ENABLED=false
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxx
RESEND_FROM=GrünWerk Gartenbau <service@gruenwerk-gartenservice.de>
MAIL_FROM=GrünWerk Gartenbau <service@gruenwerk-gartenservice.de>
ADMIN_EMAIL=deine-admin-email@example.com
MAIL_TIMEOUT_MS=30000
MAIL_RETRY_ATTEMPTS=3

DATABASE_URL=postgresql://user:password@host:5432/database

MAX_PHOTO_SIZE_MB=10

INBOUND_WEBHOOK_TOKEN=ein-langer-geheimer-webhook-token
REPLY_TO_EMAIL=

IMAP_HOST=imap.strato.de
IMAP_PORT=993
IMAP_SECURE=true
IMAP_USER=webmaster@gruenwerk-gartenservice.de
IMAP_PASS=dein-strato-postfach-passwort
IMAP_FETCH_LIMIT=30
IMAP_TIMEOUT_MS=60000

# Kalender / Terminplanung
# Uhrzeiten, die Kunden und Admins als Slots auswählen können.
CALENDAR_SLOT_TIMES=08:00,09:00,10:00,11:00,12:00,13:00,14:00,15:00,16:00,17:00
# Anzahl Tage, die im Admin-Kalender angezeigt werden.
CALENDAR_DAYS_AHEAD=21
