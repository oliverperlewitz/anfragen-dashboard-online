ADMIN_USERNAME=admin
ADMIN_PASSWORD=DeinSicheresPasswort123!
# Sicherer als ADMIN_PASSWORD: ADMIN_PASSWORD_HASH benutzen.
# Hash erzeugen mit: node -e "const bcrypt=require('bcryptjs'); console.log(bcrypt.hashSync('DEIN_PASSWORT', 12));"
# ADMIN_PASSWORD_HASH=$2a$12$...
# Mehrere Admins sicher: ADMINS_HASHED=admin:$2a$12$...,max:$2a$12$...
# Alte einfache Variante funktioniert weiter, ist aber weniger sicher: ADMINS=admin:passwort,max:passwort2

SESSION_SECRET=ein-langer-zufaelliger-geheimer-text-123456789
PORT=3000
NODE_ENV=development
MAINTENANCE_MODE=false
MAX_BACKUPS=50

MAIL_ENABLED=false
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=deine-email@gmail.com
SMTP_PASS=dein-google-app-passwort
MAIL_FROM=GrünWerk Gartenbau <deine-email@gmail.com>
ADMIN_EMAIL=deine-admin-email@example.com
