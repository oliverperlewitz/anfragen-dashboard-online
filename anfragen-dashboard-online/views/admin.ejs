<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>Admin Dashboard</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body class="admin-body admin-pro-body">
  <% 
    const normalize = (value) => String(value || '').toLowerCase().trim();
    const linesFrom = (a) => (a.nachricht || '').split('\n');
    const getValueFrom = (a, label) => {
      const line = linesFrom(a).find(item => item.startsWith(label + ':'));
      return line ? line.replace(label + ':', '').trim() : '-';
    };
    const getDetailsFrom = (a) => {
      const lines = linesFrom(a);
      const detailsIndex = lines.findIndex(item => item.trim() === 'Details:');
      return detailsIndex >= 0 ? lines.slice(detailsIndex + 1).join('\n').trim() : (a.nachricht || '-');
    };
    const getLeistung = (a) => a.kategorie || getValueFrom(a, 'Leistung') || 'Sonstiges';
    const getDepartment = (a) => {
      const leistung = normalize(getLeistung(a));
      if (leistung.includes('winter')) return 'Winterdienst';
      if (leistung.includes('pflaster') || leistung.includes('wege') || leistung.includes('terrasse')) return 'Pflaster & Wege';
      if (leistung.includes('gestaltung') || leistung.includes('projekt') || leistung.includes('umgestaltung')) return 'Gartengestaltung';
      if (leistung.includes('pflege') || leistung.includes('rasen') || leistung.includes('hecke')) return 'Gartenpflege';
      return 'Sonstiges';
    };
    const statusKey = (status) => normalize(status || 'Neu').replaceAll(' ', '-');
    const departments = [
      { name: 'Gartengestaltung', icon: '🌿', subtitle: 'Planung, Umgestaltung & Konzepte' },
      { name: 'Gartenpflege', icon: '✂️', subtitle: 'Rasen, Hecke, Beete & laufende Pflege' },
      { name: 'Pflaster & Wege', icon: '🧱', subtitle: 'Wege, Terrassen & kleine Bauarbeiten' },
      { name: 'Winterdienst', icon: '❄️', subtitle: 'Räumen, Streuen & Sicherheit im Winter' },
      { name: 'Sonstiges', icon: '📌', subtitle: 'Alle weiteren Anfragen' }
    ];
    const statusOptions = [
      'Neu',
      'Gesehen',
      'Rückfrage offen',
      'Besichtigung geplant',
      'Angebot wird erstellt',
      'Angebot gesendet',
      'Warten auf Kundenantwort',
      'Angenommen',
      'Termin vereinbart',
      'In Bearbeitung',
      'Pausiert',
      'Erledigt',
      'Abgerechnet',
      'Bezahlt',
      'Abgelehnt',
      'Storniert'
    ];
    const emailStatusOptions = [
      'Neu',
      'Rückfrage offen',
      'Besichtigung geplant',
      'Angebot gesendet',
      'Termin vereinbart',
      'In Bearbeitung',
      'Pausiert',
      'Erledigt',
      'Abgerechnet',
      'Storniert'
    ];
    const statusTemplates = {
      'Rückfrage offen': [
        {
          label: 'Fehlende Informationen allgemein',
          text: 'Hallo,\n\nwir haben deine Anfrage geprüft. Für eine genaue Einschätzung benötigen wir noch ein paar Informationen:\n\n- genaue Adresse\n- Fotos vom Bereich\n- ungefähre Fläche in m²\n\nDu kannst einfach auf diese E-Mail antworten.\n\nViele Grüße\nGrünWerk Gartenbau'
        },
        {
          label: 'Weitere Fotos benötigt',
          text: 'Hallo,\n\nfür eine bessere Einschätzung benötigen wir bitte noch ein paar Fotos vom betroffenen Bereich.\n\nBitte fotografiere möglichst den gesamten Bereich und wichtige Details.\n\nViele Grüße\nGrünWerk Gartenbau'
        }
      ],
      'Besichtigung geplant': [
        {
          label: 'Standard-Besichtigung',
          text: 'Hallo,\n\nwir haben eine Besichtigung für [Datum] um [Uhrzeit] eingeplant.\n\nBitte sorge dafür, dass der Bereich zugänglich ist.\n\nViele Grüße\nGrünWerk Gartenbau'
        },
        {
          label: 'Termin bestätigen lassen',
          text: 'Hallo,\n\nwir können dir eine Besichtigung am [Datum] um [Uhrzeit] anbieten.\n\nBitte antworte kurz, ob dieser Termin für dich passt.\n\nViele Grüße\nGrünWerk Gartenbau'
        }
      ],
      'Angebot gesendet': [
        {
          label: 'Angebot verschickt',
          text: 'Hallo,\n\nwir haben dir unser Angebot zu deiner Anfrage gesendet.\n\nBei Fragen kannst du einfach auf diese E-Mail antworten.\n\nViele Grüße\nGrünWerk Gartenbau'
        }
      ],
      'Warten auf Kundenantwort': [
        {
          label: 'Freundliche Erinnerung',
          text: 'Hallo,\n\nwir wollten kurz nachfragen, ob du zu deiner Anfrage bereits eine Entscheidung treffen konntest.\n\nBei Fragen sind wir gerne für dich da.\n\nViele Grüße\nGrünWerk Gartenbau'
        }
      ],
      'Termin vereinbart': [
        {
          label: 'Arbeitstermin bestätigt',
          text: 'Hallo,\n\nder Termin für die Ausführung ist für [Datum] um [Uhrzeit] vereinbart.\n\nBitte stelle sicher, dass der Bereich zugänglich ist.\n\nViele Grüße\nGrünWerk Gartenbau'
        }
      ],
      'In Bearbeitung': [
        {
          label: 'Auftrag gestartet',
          text: 'Hallo,\n\nwir haben mit deinem Auftrag begonnen.\n\nFalls sich während der Ausführung etwas Wichtiges ergibt, melden wir uns bei dir.\n\nViele Grüße\nGrünWerk Gartenbau'
        }
      ],
      'Pausiert': [
        {
          label: 'Wetter / Material / Termin',
          text: 'Hallo,\n\nwir müssen die Arbeiten vorübergehend pausieren. Grund: [Grund eintragen].\n\nWir melden uns, sobald es weitergeht.\n\nViele Grüße\nGrünWerk Gartenbau'
        }
      ],
      'Erledigt': [
        {
          label: 'Arbeiten abgeschlossen',
          text: 'Hallo,\n\ndie Arbeiten wurden abgeschlossen.\n\nVielen Dank für dein Vertrauen. Bei Fragen kannst du dich gerne melden.\n\nViele Grüße\nGrünWerk Gartenbau'
        }
      ],
      'Abgerechnet': [
        {
          label: 'Rechnung / Abrechnung',
          text: 'Hallo,\n\nder Auftrag wurde abgerechnet.\n\nDie Rechnung erhältst du separat bzw. wurde bereits übermittelt.\n\nViele Grüße\nGrünWerk Gartenbau'
        }
      ],
      'Storniert': [
        {
          label: 'Auftrag storniert',
          text: 'Hallo,\n\nder Auftrag wurde storniert.\n\nFalls du später erneut Unterstützung brauchst, kannst du dich gerne wieder melden.\n\nViele Grüße\nGrünWerk Gartenbau'
        }
      ]
    };
    const total = anfragen.length;
    const countStatus = (name) => anfragen.filter(a => (a.status || 'Neu') === name).length;
    const grouped = departments.map(dep => ({ ...dep, items: anfragen.filter(a => getDepartment(a) === dep.name) }));
    const asArray = (value) => Array.isArray(value) ? value : [];
    const photoTitle = (photo) => [photo.originalName || 'Foto', photo.uploadedAtLabel || '', photo.uploadedBy ? ('von ' + photo.uploadedBy) : ''].filter(Boolean).join(' · ');
    const photoUrl = (a, photo) => `/admin/photo/${encodeURIComponent(a.id)}/${encodeURIComponent(photo.id)}`;
    const photoDownloadUrl = (a, photo) => `/admin/photo/${encodeURIComponent(a.id)}/${encodeURIComponent(photo.id)}/download`;
    const shortText = (value, length = 1200) => {
      const text = String(value || '');
      return text.length > length ? text.slice(0, length) + '…' : text;
    };
    const openGeneralEmails = Array.isArray(generalEmails) ? generalEmails : [];
    const assignableRequests = Array.isArray(allAnfragen) ? allAnfragen : anfragen;
    const calendarDaysSafe = Array.isArray(calendarDays) ? calendarDays : [];
    const unscheduledRequests = anfragen.filter(a => !(a.calendarDate && a.calendarTime)).slice(0, 20);
    const calendarStatusOptions = [
      ['pending', 'Möglicher Auftrag'],
      ['confirmed', 'Termin bestätigt'],
      ['working', 'In Arbeit'],
      ['done', 'Erledigt']
    ];
    const fixReplyMojibake = (value) => {
      const text = String(value || '');
      if (!/[ÃÂâ]/.test(text)) return text;
      try {
        const fixed = Buffer.from(text, 'latin1').toString('utf8');
        return fixed.includes('�') ? text : fixed;
      } catch (error) {
        return text;
      }
    };
    const cleanReplyPreview = (value) => {
      let text = fixReplyMojibake(value)
        .replace(/\r\n/g, '\n')
        .replace(/\u00a0/g, ' ')
        .replace(/[ \t]+$/gm, '')
        .trim();

      const inlineCutPatterns = [
        /\s+GrünWerk\s+Gartenbau\s*<[^>]+>\s+schrieb\s+am\s+.{0,160}?(?:[:>]|$)/i,
        /\s+[\p{L}0-9 ._'-]+\s*<[^>]+>\s+schrieb\s+am\s+.{0,160}?(?:[:>]|$)/iu,
        /\s+Am\s+.{0,220}?\s+schrieb\s+.{0,160}?(?:[:>]|$)/i,
        /\s+On\s+.{0,220}?\s+wrote\s*:/i,
        /\s+-----Original Message-----/i,
        /\s+(?:Von|From):\s+/i
      ];
      for (const pattern of inlineCutPatterns) {
        const match = text.match(pattern);
        if (match && typeof match.index === 'number' && match.index > 0) {
          text = text.slice(0, match.index).trim();
          break;
        }
      }

      const cleanedLines = [];
      const stopLinePatterns = [
        /^>+/,
        /^\s*Am\s+.+\s+schrieb\s+.+:/i,
        /^\s*On\s+.+\s+wrote:/i,
        /^\s*GrünWerk\s+Gartenbau\s*<[^>]+>\s+schrieb\s+am\s+/i,
        /^\s*[\p{L}0-9 ._'-]+\s*<[^>]+>\s+schrieb\s+am\s+/iu,
        /^\s*(Von|From|Gesendet|Sent|An|To|Betreff|Subject):\s+/i
      ];
      for (const line of text.split('\n')) {
        const trimmed = line.trim();
        if (!trimmed) continue;
        if (stopLinePatterns.some(pattern => pattern.test(trimmed))) break;
        cleanedLines.push(trimmed.replace(/^>+\s*/, ''));
      }

      text = cleanedLines.join('\n')
        .replace(/\s*>\s*>\s*/g, '\n')
        .replace(/\s*>\s*/g, '\n')
        .split('\n')
        .map(line => line.trim())
        .filter(Boolean)
        .join('\n')
        .replace(/\n{3,}/g, '\n\n')
        .trim();

      return shortText(text || '(keine reine Antwort erkannt)', 1200);
    };

  %>

  <aside class="admin-sidebar" aria-label="Admin Navigation">
    <a class="sidebar-brand" href="/admin" aria-label="GrünWerk Admin Cockpit">
      <span class="brand-icon sidebar-brand-icon">☘</span>
      <span>
        <strong>GrünWerk</strong>
        <small>Admin Cockpit</small>
      </span>
    </a>

    <nav class="sidebar-nav">
      <a class="sidebar-link active" href="#uebersicht" data-nav-page="uebersicht"><span>🏠</span> Übersicht</a>
      <a class="sidebar-link" href="#anfragen" data-nav-page="anfragen"><span>📋</span> Anfragen</a>
      <a class="sidebar-link" href="#kalender" data-nav-page="kalender"><span>📅</span> Kalender</a>
      <a class="sidebar-link" href="#emails" data-nav-page="emails"><span>✉️</span> E-Mails</a>
      <div class="sidebar-group sidebar-security-group" data-security-nav>
        <a class="sidebar-link sidebar-security-main" href="#sicherheit" data-nav-page="sicherheit"><span>🛡️</span> Sicherheit</a>
        <div class="sidebar-subnav">
          <a href="#backups" data-nav-page="sicherheit">Backups</a>
          <a href="#aktivitaetsprotokoll" data-nav-page="sicherheit">Aktivitätsprotokoll</a>
          <a href="#login-historie" data-nav-page="sicherheit">Login-Historie</a>
          <a href="#geloeschte-anfragen" data-nav-page="sicherheit">Gelöschte Anfragen</a>
        </div>
      </div>
    </nav>

    <div class="sidebar-bottom sidebar-note">
      <span>GrünWerk Verwaltung</span>
      <small>Navigation links · Aktionen oben rechts</small>
    </div>
  </aside>

  <header class="admin-shell-header admin-shell-header-compact">
    <button class="sidebar-mobile-toggle" type="button" data-sidebar-toggle aria-label="Navigation öffnen">☰</button>
    <div class="admin-header-spacer"></div>
    <details class="admin-profile-menu" id="profil">
      <summary class="admin-user-chip" title="Eingeloggt als <%= username || 'Admin' %>">
        <span class="admin-user-dot">👋</span>
        <span><strong><%= username || 'Admin' %></strong> · <em><%= roleLabel || 'Admin' %></em></span>
        <span class="profile-chevron">⌄</span>
      </summary>
      <div class="profile-menu-panel">
        <a href="#profil">Profil</a>
        <% if (permissions && permissions.canManageUsers) { %>
          <a href="/admin/users">Benutzer verwalten</a>
        <% } %>
        <a href="/" target="_blank">Website ansehen</a>
        <form action="/logout" method="POST">
          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
          <button type="submit">Ausloggen</button>
        </form>
      </div>
    </details>
  </header>

  <main class="admin-pro-main" data-admin-pages>
    <section id="uebersicht" class="admin-hero-panel" data-admin-page="uebersicht">
      <div>
        <p class="admin-kicker">Anfragen Management</p>
        <h1>Dashboard</h1>
        <p class="admin-subline">Alle Kundenanfragen sauber nach Abteilungen, Status und Kontaktdaten sortiert.</p>
      </div>
      <div class="admin-hero-stats">
        <div><span>Gesamt</span><strong><%= total %></strong></div>
        <div><span>Neu</span><strong><%= countStatus('Neu') %></strong></div>
        <div><span>In Arbeit</span><strong><%= countStatus('In Bearbeitung') %></strong></div>
        <div><span>Erledigt</span><strong><%= countStatus('Erledigt') %></strong></div>
      </div>
    </section>

    <section class="overview-home-grid" data-admin-page="uebersicht">
      <a class="overview-home-card" href="#anfragen">
        <span>📋</span>
        <strong>Anfragen öffnen</strong>
        <small>Alle Kundenaufträge, Felder, Fotos, Notizen und Statusänderungen.</small>
      </a>
      <a class="overview-home-card" href="#kalender">
        <span>📅</span>
        <strong>Kalender öffnen</strong>
        <small>Termine, mögliche Aufträge und freie Zeiten planen.</small>
      </a>
      <a class="overview-home-card" href="#emails">
        <span>✉️</span>
        <strong>E-Mails öffnen</strong>
        <small>STRATO abrufen, Kundenantworten und allgemeine E-Mails verwalten.</small>
      </a>
      <a class="overview-home-card" href="#sicherheit">
        <span>🛡️</span>
        <strong>Sicherheit öffnen</strong>
        <small>Backups, Aktivitäten, Login-Historie und gelöschte Anfragen.</small>
      </a>
    </section>

    <% if (mailSync) { %>
      <section class="admin-alert success-alert" data-admin-page="uebersicht"><%= mailSync %></section>
    <% } %>
    <% if (mailError) { %>
      <section class="admin-alert error-alert" data-admin-page="uebersicht"><%= mailError %></section>
    <% } %>

    <section id="emails" class="admin-toolbar-panel mail-sync-panel" data-admin-page="emails" hidden>
      <div>
        <strong>Kundenantworten aus STRATO abrufen</strong>
        <p>Importiert neue Antworten aus dem STRATO-Postfach und ordnet sie über die Anfragenummer im Betreff zu.</p>
      </div>
      <form action="/admin/fetch-mails" method="POST">
        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
        <button type="submit" <%= imapReady ? '' : 'disabled' %>>E-Mails abrufen</button>
      </form>
      <% if (!imapReady) { %>
        <small>IMAP ist noch nicht eingerichtet. Trage IMAP_HOST, IMAP_USER und IMAP_PASS bei Render ein.</small>
      <% } %>
    </section>

    <section id="kalender" class="admin-panel calendar-panel" data-admin-page="kalender" hidden>
      <div class="department-section-head compact-head calendar-head">
        <div>
          <p class="admin-kicker">Terminplanung</p>
          <h2>Kalender</h2>
          <p>Orange bedeutet möglicher Auftrag aus dem Kundenformular. Ziehe eine Auftragskarte auf einen freien Slot oder plane den Termin im Auftrag manuell.</p>
        </div>
        <div class="calendar-legend">
          <span><i class="legend-dot calendar-pending"></i> Möglicher Auftrag</span>
          <span><i class="legend-dot calendar-confirmed"></i> Termin bestätigt</span>
          <span><i class="legend-dot calendar-working"></i> In Arbeit</span>
          <span><i class="legend-dot calendar-done"></i> Erledigt</span>
        </div>
      </div>

      <% if (unscheduledRequests.length) { %>
        <div class="calendar-drag-pool">
          <strong>Nicht eingeplante Aufträge</strong>
          <div class="calendar-drag-list">
            <% unscheduledRequests.forEach(item => { %>
              <div class="calendar-drag-item" draggable="true" data-drag-request-id="<%= item.id %>">
                <span>#<%= String(item.id || '').slice(-6) %></span>
                <strong><%= item.name || 'Ohne Name' %></strong>
                <small><%= item.kategorie || item.leistung || 'Auftrag' %></small>
              </div>
            <% }) %>
          </div>
        </div>
      <% } %>

      <div class="calendar-grid calendar-grid-compact" data-calendar-grid>
        <% calendarDaysSafe.forEach(day => { %>
          <%
            const daySlots = Array.isArray(day.slots) ? day.slots : [];
            const dayEvents = daySlots.flatMap(slot => Array.isArray(slot.events) ? slot.events : []);
            const freeCount = daySlots.filter(slot => slot.available).length;
            const pendingCount = dayEvents.filter(event => event.calendarStatus === 'pending').length;
            const confirmedCount = dayEvents.filter(event => event.calendarStatus === 'confirmed').length;
            const workingCount = dayEvents.filter(event => event.calendarStatus === 'working').length;
            const doneCount = dayEvents.filter(event => event.calendarStatus === 'done').length;
          %>
          <details class="calendar-day calendar-day-compact <%= day.isToday ? 'is-today' : '' %>">
            <summary class="calendar-day-summary">
              <div class="calendar-day-title">
                <strong><%= day.label %></strong>
                <span><%= day.date %></span>
              </div>
              <div class="calendar-day-stats">
                <% if (dayEvents.length) { %>
                  <span class="day-stat total"><%= dayEvents.length %> Termin<%= dayEvents.length === 1 ? '' : 'e' %></span>
                <% } else { %>
                  <span class="day-stat free">frei</span>
                <% } %>
                <% if (pendingCount) { %><span class="day-stat pending"><%= pendingCount %> möglich</span><% } %>
                <% if (confirmedCount) { %><span class="day-stat confirmed"><%= confirmedCount %> bestätigt</span><% } %>
                <% if (workingCount) { %><span class="day-stat working"><%= workingCount %> in Arbeit</span><% } %>
                <% if (doneCount) { %><span class="day-stat done"><%= doneCount %> erledigt</span><% } %>
              </div>
              <span class="calendar-open-hint">Uhrzeiten anzeigen</span>
            </summary>
            <div class="calendar-slots compact-slots">
              <% daySlots.forEach(slot => { %>
                <div class="calendar-slot <%= slot.available ? 'slot-free' : 'slot-booked' %>" data-drop-date="<%= slot.date %>" data-drop-time="<%= slot.time %>">
                  <div class="slot-time"><%= slot.time %></div>
                  <% if (slot.events.length) { %>
                    <% slot.events.forEach(event => { %>
                      <a class="calendar-event calendar-event-<%= event.calendarStatus %>" href="#request-<%= event.id %>">
                        <span><%= event.calendarStatusLabel %></span>
                        <strong><%= event.ticket %> · <%= event.name %></strong>
                        <small><%= event.leistung %></small>
                      </a>
                    <% }) %>
                  <% } else { %>
                    <span class="slot-free-label">frei</span>
                  <% } %>
                </div>
              <% }) %>
            </div>
          </details>
        <% }) %>
      </div>
    </section>

    <section id="general-emails" class="admin-panel general-mails-panel" data-admin-page="emails" hidden>
      <div class="department-section-head compact-head">
        <div>
          <p class="admin-kicker">Posteingang</p>
          <h2>Allgemeine E-Mails</h2>
          <p>E-Mails ohne Auftragsnummer landen hier. Du kannst daraus eine neue Anfrage erstellen, sie einem bestehenden Auftrag zuordnen oder als erledigt/archiviert markieren.</p>
        </div>
        <div class="department-count"><strong><%= openGeneralEmails.length %></strong><span>offen</span></div>
      </div>

      <% if (openGeneralEmails.length === 0) { %>
        <div class="general-empty-state">
          <strong>Keine allgemeinen E-Mails offen.</strong>
          <p>Klicke oben auf „E-Mails abrufen“. Wenn eine Mail keine #Anfragenummer im Betreff hat, erscheint sie hier.</p>
        </div>
      <% } else { %>
        <div class="general-mail-list">
          <% openGeneralEmails.forEach(mail => { %>
            <article class="general-mail-card">
              <div class="general-mail-head">
                <div>
                  <span class="general-mail-badge">Allgemeine E-Mail</span>
                  <h3><%= mail.subject || '(ohne Betreff)' %></h3>
                  <p><strong>Von:</strong> <%= mail.from || '-' %></p>
                </div>
                <time><%= mail.receivedAtLabel || '' %></time>
              </div>

              <div class="general-mail-message">
                <span>Nachricht</span>
                <p><%= cleanReplyPreview(mail.text || '') %></p>
              </div>

              <% if (mail.photoCount || (mail.photos && mail.photos.length)) { %>
                <div class="general-mail-attachments">📎 <%= mail.photoCount || mail.photos.length %> Bildanhang/Bildanhänge erkannt</div>
              <% } %>

              <div class="general-mail-actions">
                <form action="/admin/general-emails/<%= mail.id %>/create-request" method="POST" onsubmit="return confirm('Aus dieser E-Mail eine neue Anfrage erstellen?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit">Neue Anfrage erstellen</button>
                </form>

                <form action="/admin/general-emails/<%= mail.id %>/assign" method="POST" class="assign-mail-form">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <select name="requestId" required>
                    <option value="">Bestehendem Auftrag zuordnen</option>
                    <% assignableRequests.slice(0, 80).forEach(reqItem => { %>
                      <option value="<%= reqItem.id %>">#<%= String(reqItem.id || '').slice(-6) %> · <%= reqItem.name || 'Ohne Name' %> · <%= reqItem.kategorie || reqItem.leistung || 'Sonstiges' %></option>
                    <% }) %>
                  </select>
                  <button type="submit" class="secondary">Zuordnen</button>
                </form>

                <form action="/admin/general-emails/<%= mail.id %>/done" method="POST">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="secondary">Als erledigt markieren</button>
                </form>

                <form action="/admin/general-emails/<%= mail.id %>/archive" method="POST" onsubmit="return confirm('Diese E-Mail archivieren/ignorieren?');">
                  <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                  <button type="submit" class="ghost-danger">Ignorieren / archivieren</button>
                </form>
              </div>
            </article>
          <% }) %>
        </div>
      <% } %>
    </section>

    <section class="admin-toolbar-panel" data-admin-page="anfragen" hidden>
      <form action="/admin" method="GET" class="admin-pro-search">
        <input name="suche" value="<%= suche %>" placeholder="Suchen nach Name, Telefon, E-Mail, Ort, Leistung oder Status...">
        <button type="submit">Suchen</button>
        <a class="button secondary" href="/admin">Zurücksetzen</a>
      </form>
    </section>

    <section id="anfragen" class="department-overview" data-admin-page="anfragen" hidden>
      <% grouped.forEach(dep => { %>
        <a class="department-tile" href="#dep-<%= dep.name.toLowerCase().replaceAll(' ', '-').replaceAll('&', 'und') %>">
          <span class="department-icon"><%= dep.icon %></span>
          <div>
            <strong><%= dep.name %></strong>
            <small><%= dep.items.length %> Anfrage<%= dep.items.length === 1 ? '' : 'n' %></small>
          </div>
        </a>
      <% }) %>
    </section>

    <% if (anfragen.length === 0) { %>
      <section class="admin-panel empty-state" data-admin-page="anfragen" hidden>
        <h2>Keine Anfragen gefunden.</h2>
        <p>Neue Projektanfragen erscheinen automatisch hier.</p>
      </section>
    <% } else { %>
      <section class="department-stack" data-admin-page="anfragen" hidden>
        <% grouped.forEach(dep => { %>
          <section class="department-section" id="dep-<%= dep.name.toLowerCase().replaceAll(' ', '-').replaceAll('&', 'und') %>">
            <div class="department-section-head">
              <div class="department-title-wrap">
                <span class="department-big-icon"><%= dep.icon %></span>
                <div>
                  <p class="admin-kicker">Abteilung</p>
                  <h2><%= dep.name %></h2>
                  <p><%= dep.subtitle %></p>
                </div>
              </div>
              <div class="department-count"><strong><%= dep.items.length %></strong><span>Anfrage<%= dep.items.length === 1 ? '' : 'n' %></span></div>
            </div>

            <% if (dep.items.length === 0) { %>
              <div class="department-empty">Keine offenen Einträge in dieser Abteilung.</div>
            <% } else { %>
              <div class="department-request-grid">
                <% dep.items.forEach(a => { 
                  const leistung = getLeistung(a);
                  const detailsText = getDetailsFrom(a);
                  const budgetValue = a.budget || getValueFrom(a, 'Budget');
                  const formattedBudget = budgetValue && budgetValue !== '-' ? (String(budgetValue).includes('€') ? budgetValue : budgetValue + ' €') : 'Nicht angegeben';
                  const currentStatusKey = statusKey(a.status);
                %>
                  <article id="request-<%= a.id %>" class="admin-request-card compact-request-card <%= currentStatusKey %>" draggable="true" data-drag-request-id="<%= a.id %>">
                    <details class="request-card-details">
                      <summary class="request-card-summary" aria-label="Auftrag von <%= a.name %> öffnen">
                        <div class="admin-request-top compact-request-top">
                          <div>
                            <span class="status-pill status-pill-<%= currentStatusKey %>"><%= a.status || 'Neu' %></span>
                            <h3><%= a.name %></h3>
                            <p class="request-date"><%= a.datum %></p>
                          </div>
                          <div class="request-id">#<%= String(a.id || '').slice(-6) %></div>
                        </div>
                        <span class="request-open-hint">Details öffnen</span>
                      </summary>

                      <div class="request-expanded-content">
                    <% if (permissions && permissions.canWriteNotes) { %>
                      <form id="request-inline-edit-<%= a.id %>" class="inline-edit-master-form" action="/admin/request/<%= a.id %>/update" method="POST">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <input type="hidden" name="name" value="<%= a.name || '' %>">
                        <input type="hidden" name="email" value="<%= a.email || '' %>">
                        <input type="hidden" name="telefon" value="<%= a.telefon || '' %>">
                        <input type="hidden" name="kategorie" value="<%= a.kategorie || a.leistung || leistung || '' %>">
                        <input type="hidden" name="budget" value="<%= a.budget || '' %>">
                        <input type="hidden" name="adresse" value="<%= a.adresse || getValueFrom(a, 'Adresse / Ort') || '' %>">
                        <input type="hidden" name="auftragsart" value="<%= a.auftragsart || getValueFrom(a, 'Auftragsart') || '' %>">
                        <input type="hidden" name="groesse" value="<%= a.groesse || getValueFrom(a, 'Grundstücksgröße') || '' %>">
                        <input type="hidden" name="zeitraum" value="<%= a.zeitraum || getValueFrom(a, 'Zeitraum') || '' %>">
                        <input type="hidden" name="besichtigung" value="<%= a.besichtigung || getValueFrom(a, 'Besichtigung') || '' %>">
                        <input type="hidden" name="erreichbarkeit" value="<%= a.erreichbarkeit || getValueFrom(a, 'Erreichbarkeit') || '' %>">
                        <input type="hidden" name="kontaktart" value="<%= a.kontaktart || getValueFrom(a, 'Bevorzugte Kontaktart') || '' %>">
                        <input type="hidden" name="details" value="<%= detailsText || '' %>">
                      </form>
                    <% } %>
                    <div class="admin-card-grid">
                      <div class="mini-box primary-mini editable-data-slot">
                        <div>
                          <span>Leistung</span>
                          <strong><%= leistung %></strong>
                        </div>
                        <% if (permissions && permissions.canWriteNotes) { %><button type="button" class="inline-edit-pencil" data-edit-form="request-inline-edit-<%= a.id %>" data-edit-field="kategorie" data-edit-label="Leistung" data-edit-value="<%= leistung || '' %>" aria-label="Leistung bearbeiten">✎</button><% } %>
                      </div>
                      <div class="mini-box editable-data-slot">
                        <div>
                          <span>Budget</span>
                          <strong><%= formattedBudget %></strong>
                        </div>
                        <% if (permissions && permissions.canWriteNotes) { %><button type="button" class="inline-edit-pencil" data-edit-form="request-inline-edit-<%= a.id %>" data-edit-field="budget" data-edit-label="Budget" data-edit-value="<%= a.budget || '' %>" aria-label="Budget bearbeiten">✎</button><% } %>
                      </div>
                      <div class="mini-box editable-data-slot">
                        <div>
                          <span>Telefon</span>
                          <strong><%= a.telefon || '-' %></strong>
                        </div>
                        <% if (permissions && permissions.canWriteNotes) { %><button type="button" class="inline-edit-pencil" data-edit-form="request-inline-edit-<%= a.id %>" data-edit-field="telefon" data-edit-label="Telefon" data-edit-value="<%= a.telefon || '' %>" aria-label="Telefon bearbeiten">✎</button><% } %>
                      </div>
                      <div class="mini-box editable-data-slot">
                        <div>
                          <span>E-Mail</span>
                          <strong><%= a.email || '-' %></strong>
                        </div>
                        <% if (permissions && permissions.canWriteNotes) { %><button type="button" class="inline-edit-pencil" data-edit-form="request-inline-edit-<%= a.id %>" data-edit-field="email" data-edit-label="E-Mail" data-edit-value="<%= a.email || '' %>" aria-label="E-Mail bearbeiten">✎</button><% } %>
                      </div>
                    </div>

                    <details class="calendar-request-panel compact-subpanel" <%= a.calendarDate && a.calendarTime ? '' : 'open' %>>
                      <summary>Terminplanung <%= a.calendarDate && a.calendarTime ? '· ' + a.calendarDate + ' ' + a.calendarTime : '' %></summary>
                      <form action="/admin/calendar/<%= a.id %>" method="POST" class="calendar-request-form">
                        <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                        <div class="calendar-form-grid">
                          <label>
                            <span>Datum</span>
                            <input type="date" name="calendarDate" value="<%= a.calendarDate || a.wunschDatum || '' %>">
                          </label>
                          <label>
                            <span>Uhrzeit</span>
                            <select name="calendarTime">
                              <option value="">Uhrzeit wählen</option>
                              <% (calendarSlotTimes || []).forEach(time => { %>
                                <option value="<%= time %>" <%= (a.calendarTime || a.wunschUhrzeit || '') === time ? 'selected' : '' %>><%= time %> Uhr</option>
                              <% }) %>
                            </select>
                          </label>
                          <label>
                            <span>Kalenderstatus</span>
                            <select name="calendarStatus">
                              <% calendarStatusOptions.forEach(([value, label]) => { %>
                                <option value="<%= value %>" <%= (a.calendarStatus || 'pending') === value ? 'selected' : '' %>><%= label %></option>
                              <% }) %>
                            </select>
                          </label>
                          <label>
                            <span>Kalendernotiz</span>
                            <input name="calendarNote" value="<%= a.calendarNote || '' %>" placeholder="z. B. Besichtigung, Ausführung, Material mitbringen">
                          </label>
                        </div>
                        <div class="calendar-form-actions">
                          <button type="submit">Termin speichern</button>
                          <% if (a.calendarDate && a.calendarTime) { %>
                            <button type="submit" class="secondary" name="clearCalendar" value="1">Termin entfernen</button>
                          <% } %>
                        </div>
                      </form>
                    </details>

                    <div class="admin-section-block">
                      <h4>Auftragsdaten</h4>
                      <div class="data-list">
                        <div class="editable-data-row"><div><span>Adresse / Ort</span><strong><%= a.adresse || getValueFrom(a, 'Adresse / Ort') %></strong></div><% if (permissions && permissions.canWriteNotes) { %><button type="button" class="inline-edit-pencil small" data-edit-form="request-inline-edit-<%= a.id %>" data-edit-field="adresse" data-edit-label="Adresse / Ort" data-edit-value="<%= a.adresse || getValueFrom(a, 'Adresse / Ort') || '' %>" aria-label="Adresse / Ort bearbeiten">✎</button><% } %></div>
                        <div class="editable-data-row"><div><span>Auftragsart</span><strong><%= a.auftragsart || getValueFrom(a, 'Auftragsart') %></strong></div><% if (permissions && permissions.canWriteNotes) { %><button type="button" class="inline-edit-pencil small" data-edit-form="request-inline-edit-<%= a.id %>" data-edit-field="auftragsart" data-edit-label="Auftragsart" data-edit-value="<%= a.auftragsart || getValueFrom(a, 'Auftragsart') || '' %>" aria-label="Auftragsart bearbeiten">✎</button><% } %></div>
                        <div class="editable-data-row"><div><span>Grundstücksgröße</span><strong><%= a.groesse || getValueFrom(a, 'Grundstücksgröße') %></strong></div><% if (permissions && permissions.canWriteNotes) { %><button type="button" class="inline-edit-pencil small" data-edit-form="request-inline-edit-<%= a.id %>" data-edit-field="groesse" data-edit-label="Grundstücksgröße" data-edit-value="<%= a.groesse || getValueFrom(a, 'Grundstücksgröße') || '' %>" aria-label="Grundstücksgröße bearbeiten">✎</button><% } %></div>
                        <div class="editable-data-row"><div><span>Zeitraum</span><strong><%= a.zeitraum || getValueFrom(a, 'Zeitraum') %></strong></div><% if (permissions && permissions.canWriteNotes) { %><button type="button" class="inline-edit-pencil small" data-edit-form="request-inline-edit-<%= a.id %>" data-edit-field="zeitraum" data-edit-label="Zeitraum" data-edit-value="<%= a.zeitraum || getValueFrom(a, 'Zeitraum') || '' %>" aria-label="Zeitraum bearbeiten">✎</button><% } %></div>
                      </div>
                    </div>

                    <div class="admin-section-block muted-block">
                      <h4>Kontakt & Planung</h4>
                      <div class="data-list two">
                        <div class="editable-data-row"><div><span>Besichtigung</span><strong><%= a.besichtigung || getValueFrom(a, 'Besichtigung') %></strong></div><% if (permissions && permissions.canWriteNotes) { %><button type="button" class="inline-edit-pencil small" data-edit-form="request-inline-edit-<%= a.id %>" data-edit-field="besichtigung" data-edit-label="Besichtigung" data-edit-value="<%= a.besichtigung || getValueFrom(a, 'Besichtigung') || '' %>" aria-label="Besichtigung bearbeiten">✎</button><% } %></div>
                        <div class="editable-data-row"><div><span>Erreichbarkeit</span><strong><%= a.erreichbarkeit || getValueFrom(a, 'Erreichbarkeit') %></strong></div><% if (permissions && permissions.canWriteNotes) { %><button type="button" class="inline-edit-pencil small" data-edit-form="request-inline-edit-<%= a.id %>" data-edit-field="erreichbarkeit" data-edit-label="Erreichbarkeit" data-edit-value="<%= a.erreichbarkeit || getValueFrom(a, 'Erreichbarkeit') || '' %>" aria-label="Erreichbarkeit bearbeiten">✎</button><% } %></div>
                        <div class="editable-data-row"><div><span>Kontaktart</span><strong><%= a.kontaktart || getValueFrom(a, 'Bevorzugte Kontaktart') %></strong></div><% if (permissions && permissions.canWriteNotes) { %><button type="button" class="inline-edit-pencil small" data-edit-form="request-inline-edit-<%= a.id %>" data-edit-field="kontaktart" data-edit-label="Kontaktart" data-edit-value="<%= a.kontaktart || getValueFrom(a, 'Bevorzugte Kontaktart') || '' %>" aria-label="Kontaktart bearbeiten">✎</button><% } %></div>
                      </div>
                    </div>

                    <% if (permissions && permissions.canWriteNotes) { %>
                      <p class="inline-edit-help">Klicke auf das Stift-Symbol ✎ neben einem Feld, um es direkt zu bearbeiten.</p>
                    <% } %>

                    <details class="request-details-clean editable-details-block">
                      <summary>Details zum Auftrag anzeigen</summary>
                      <div class="details-edit-row">
                        <p><%= detailsText || '-' %></p>
                        <% if (permissions && permissions.canWriteNotes) { %><button type="button" class="inline-edit-pencil" data-edit-form="request-inline-edit-<%= a.id %>" data-edit-field="details" data-edit-label="Details / Kundenwunsch" data-edit-value="<%= detailsText || '' %>" data-edit-multiline="true" aria-label="Details bearbeiten">✎</button><% } %>
                      </div>
                    </details>

                    <% const replies = asArray(a.customerReplies); %>
                    <details class="collapsible-admin-block customer-replies-block" <%= replies.length ? 'open' : '' %>>
                      <summary>Kundenantworten anzeigen <span class="summary-count"><%= replies.length %></span></summary>
                      <div class="collapsible-admin-content">
                        <h4>Kundenantworten</h4>
                        <p class="internal-note-hint">Antworten auf E-Mails werden automatisch diesem Auftrag zugeordnet, wenn die Anfragenummer im Betreff steht.</p>
                        <% if (replies.length) { %>
                          <div class="reply-list clean-reply-list">
                            <% replies.forEach((reply, index) => { %>
                              <article class="reply-item clean-reply-item">
                                <div class="reply-head clean-reply-head">
                                  <div>
                                    <span class="reply-label">Kundenantwort <%= replies.length - index %></span>
                                    <strong><%= reply.from || '-' %></strong>
                                  </div>
                                  <time><%= reply.receivedAtLabel || '' %></time>
                                </div>
                                <div class="reply-subject clean-reply-subject"><%= reply.subject || '(ohne Betreff)' %></div>
                                <div class="reply-message-box reply-message-clean">
                                  <span class="reply-message-label">Nachricht</span>
                                  <p><%= cleanReplyPreview(reply.text || '') %></p>
                                </div>
                                <% if (Array.isArray(reply.autoUpdatedFields) && reply.autoUpdatedFields.length) { %>
                                  <div class="auto-filled-box">Automatisch ergänzt: <%= reply.autoUpdatedFields.join(' · ') %></div>
                                <% } %>
                                <div class="reply-meta-row">
                                  <% if (reply.photoCount) { %>
                                    <span>📎 <%= reply.photoCount %> Bild<%= reply.photoCount === 1 ? '' : 'er' %> gespeichert</span>
                                  <% } else { %>
                                    <span>Keine Bildanhänge</span>
                                  <% } %>
                                  <% if (reply.attachmentCount && reply.attachmentCount !== reply.photoCount) { %>
                                    <span><%= reply.attachmentCount %> Anhang<%= reply.attachmentCount === 1 ? '' : 'e' %> erkannt</span>
                                  <% } %>
                                </div>
                              </article>
                            <% }) %>
                          </div>
                        <% } else { %>
                          <p class="evidence-empty">Noch keine Kundenantworten eingegangen.</p>
                        <% } %>
                      </div>
                    </details>

                    <details class="collapsible-admin-block evidence-block">
                      <summary>Fotos & Nachweise anzeigen</summary>
                      <div class="collapsible-admin-content">
                        <h4>Fotos & Nachweise</h4>

                      <% const customerPhotos = asArray(a.customerPhotos); %>
                      <% const beforePhotos = asArray(a.beforePhotos); %>
                      <% const afterPhotos = asArray(a.afterPhotos); %>

                      <div class="evidence-section">
                        <div class="evidence-title"><span>📩 Kundenfotos</span><small><%= customerPhotos.length %> Datei<%= customerPhotos.length === 1 ? '' : 'en' %></small></div>
                        <% if (customerPhotos.length) { %>
                          <div class="photo-grid">
                            <% customerPhotos.forEach(photo => { %>
                              <figure class="photo-card">
                                <a href="<%= photoUrl(a, photo) %>" target="_blank" rel="noopener"><img src="<%= photoUrl(a, photo) %>" alt="<%= photo.originalName || 'Kundenfoto' %>"></a>
                                <a class="photo-download-link" href="<%= photoDownloadUrl(a, photo) %>">Foto herunterladen</a>
                                <figcaption><%= photoTitle(photo) %></figcaption>
                                <% if (permissions && permissions.canDeleteRequests) { %>
                                  <form action="/admin/photos/<%= a.id %>/customer/<%= photo.id %>/delete" method="POST" onsubmit="return confirm('Dieses Kundenfoto wirklich löschen?');">
                                    <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                    <button class="danger ghost-danger small-button" type="submit">Foto löschen</button>
                                  </form>
                                <% } %>
                              </figure>
                            <% }) %>
                          </div>
                        <% } else { %>
                          <p class="evidence-empty">Der Kunde hat keine Fotos hochgeladen.</p>
                        <% } %>
                      </div>

                      <div class="evidence-two-col">
                        <div class="evidence-section">
                          <div class="evidence-title"><span>📷 Vorher-Fotos</span><small><%= beforePhotos.length %> Datei<%= beforePhotos.length === 1 ? '' : 'en' %></small></div>
                          <% if (beforePhotos.length) { %>
                            <div class="photo-grid">
                              <% beforePhotos.forEach(photo => { %>
                                <figure class="photo-card">
                                  <a href="<%= photoUrl(a, photo) %>" target="_blank" rel="noopener"><img src="<%= photoUrl(a, photo) %>" alt="Vorher-Foto"></a>
                                  <a class="photo-download-link" href="<%= photoDownloadUrl(a, photo) %>">Foto herunterladen</a>
                                  <figcaption><%= photoTitle(photo) %></figcaption>
                                  <% if (permissions && permissions.canDeleteRequests) { %>
                                    <form action="/admin/photos/<%= a.id %>/before/<%= photo.id %>/delete" method="POST" onsubmit="return confirm('Dieses Vorher-Foto wirklich löschen?');">
                                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                      <button class="danger ghost-danger small-button" type="submit">Foto löschen</button>
                                    </form>
                                  <% } %>
                                </figure>
                              <% }) %>
                            </div>
                          <% } else { %>
                            <p class="evidence-empty">Noch keine Vorher-Fotos.</p>
                          <% } %>
                          <% if (permissions && permissions.canUploadPhotos) { %>
                            <form class="photo-upload-form" action="/admin/photos/<%= a.id %>/before" method="POST" enctype="multipart/form-data">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <input name="workPhotos" type="file" accept="image/jpeg,image/png,image/webp" multiple>
                              <button type="submit">Vorher-Fotos hochladen</button>
                            </form>
                          <% } %>
                        </div>

                        <div class="evidence-section">
                          <div class="evidence-title"><span>✅ Nachher-Fotos</span><small><%= afterPhotos.length %> Datei<%= afterPhotos.length === 1 ? '' : 'en' %></small></div>
                          <% if (afterPhotos.length) { %>
                            <div class="photo-grid">
                              <% afterPhotos.forEach(photo => { %>
                                <figure class="photo-card">
                                  <a href="<%= photoUrl(a, photo) %>" target="_blank" rel="noopener"><img src="<%= photoUrl(a, photo) %>" alt="Nachher-Foto"></a>
                                  <a class="photo-download-link" href="<%= photoDownloadUrl(a, photo) %>">Foto herunterladen</a>
                                  <figcaption><%= photoTitle(photo) %></figcaption>
                                  <% if (permissions && permissions.canDeleteRequests) { %>
                                    <form action="/admin/photos/<%= a.id %>/after/<%= photo.id %>/delete" method="POST" onsubmit="return confirm('Dieses Nachher-Foto wirklich löschen?');">
                                      <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                                      <button class="danger ghost-danger small-button" type="submit">Foto löschen</button>
                                    </form>
                                  <% } %>
                                </figure>
                              <% }) %>
                            </div>
                          <% } else { %>
                            <p class="evidence-empty">Noch keine Nachher-Fotos.</p>
                          <% } %>
                          <% if (permissions && permissions.canUploadPhotos) { %>
                            <form class="photo-upload-form" action="/admin/photos/<%= a.id %>/after" method="POST" enctype="multipart/form-data">
                              <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                              <input name="workPhotos" type="file" accept="image/jpeg,image/png,image/webp" multiple>
                              <button type="submit">Nachher-Fotos hochladen</button>
                            </form>
                          <% } %>
                        </div>
                      </div>
                      </div>
                    </details>

                    <details class="collapsible-admin-block internal-notes-block">
                      <summary>Interne Notizen anzeigen</summary>
                      <div class="collapsible-admin-content">
                        <h4>Interne Notizen</h4>
                      <p class="internal-note-hint">Nur im Dashboard sichtbar. Kunden sehen diese Notizen nicht.</p>
                      <% const notes = asArray(a.internalNotes); %>
                      <% if (notes.length) { %>
                        <div class="notes-list">
                          <% notes.forEach(note => { %>
                            <div class="note-item">
                              <p><%= note.text %></p>
                              <span><%= note.createdAtLabel || '' %> · <%= note.createdBy || 'Admin' %></span>
                            </div>
                          <% }) %>
                        </div>
                      <% } else { %>
                        <p class="evidence-empty">Noch keine internen Notizen.</p>
                      <% } %>
                      <% if (permissions && permissions.canWriteNotes) { %>
                        <form class="note-form" action="/admin/note/<%= a.id %>" method="POST">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <textarea name="note" placeholder="Interne Notiz hinzufügen, z. B. Kunde möchte Rückruf am Abend..." required></textarea>
                          <button type="submit">Notiz speichern</button>
                        </form>
                      <% } %>
                      </div>
                    </details>

                    <div class="admin-card-actions">
                      <details class="status-update-panel">
                        <summary>Status ändern & Kundeninfo schreiben</summary>
                        <form action="/admin/status/<%= a.id %>" method="POST" class="status-form status-smart-form" data-status-form>
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <div class="status-form-grid">
                            <label>
                              <span>Neuer Status</span>
                              <select name="status" aria-label="Status ändern" data-status-select>
                                <% statusOptions.forEach(status => { %>
                                  <option value="<%= status %>" <%= (a.status || 'Neu') === status ? 'selected' : '' %>><%= status %></option>
                                <% }) %>
                              </select>
                            </label>
                            <label>
                              <span>Vorlage</span>
                              <select data-template-select>
                                <option value="">Keine Vorlage</option>
                              </select>
                            </label>
                          </div>

                          <label class="status-message-label">
                            <span>Nachricht an Kunden</span>
                            <textarea name="customerMessage" data-message-box placeholder="Wichtige Information an den Kunden, z. B. Termin, fehlende Angaben oder Grund der Pause..."></textarea>
                          </label>

                          <label class="notify-customer-row">
                            <input type="checkbox" name="notifyCustomer" data-notify-checkbox>
                            <span>Kunden per E-Mail informieren</span>
                          </label>
                          <p class="status-email-hint" data-email-hint></p>

                          <button type="submit">Status übernehmen</button>
                        </form>
                      </details>
                      <% const statusMessages = asArray(a.statusMessages); %>
                      <% if (statusMessages.length) { %>
                        <details class="status-history-panel">
                          <summary>Gesendete Status-Infos anzeigen</summary>
                          <div class="status-history-list">
                            <% statusMessages.slice(0, 5).forEach(item => { %>
                              <div class="status-history-item">
                                <strong><%= item.status %></strong>
                                <span><%= item.createdAtLabel || '' %> · <%= item.createdBy || 'Admin' %> · <%= item.emailed ? 'E-Mail gesendet' : 'nur intern' %></span>
                                <% if (item.message) { %><p><%= item.message %></p><% } %>
                              </div>
                            <% }) %>
                          </div>
                        </details>
                      <% } %>
                      <% if (permissions && permissions.canDeleteRequests) { %>
                        <form action="/admin/delete/<%= a.id %>" method="POST" onsubmit="return confirm('Diese Anfrage wirklich löschen?');">
                          <input type="hidden" name="_csrf" value="<%= csrfToken %>">
                          <button class="danger ghost-danger" type="submit">Löschen</button>
                        </form>
                      <% } %>
                    </div>
                      </div>
                    </details>
                  </article>
                <% }) %>
              </div>
            <% } %>
          </section>
        <% }) %>
      </section>
    <% } %>


    <% if (permissions && (permissions.canDownloadBackups || permissions.canViewActivity)) { %>
      <section id="sicherheit" class="admin-panel security-hub-panel" data-admin-page="sicherheit" hidden>
        <div class="department-section-head compact-head">
          <div>
            <p class="admin-kicker">Sicherheit</p>
            <h2>Sicherheitszentrale</h2>
            <p>Backups, Aktivitäten, Login-Historie und gelöschte Anfragen an einem Ort.</p>
          </div>
        </div>
        <div class="security-hub-grid">
          <a class="security-hub-card" href="#backups"><span>💾</span><strong>Backups</strong><small>Sicherungen herunterladen</small></a>
          <a class="security-hub-card" href="#aktivitaetsprotokoll"><span>📜</span><strong>Aktivitätsprotokoll</strong><small>Statusänderungen und Aktionen</small></a>
          <a class="security-hub-card" href="#login-historie"><span>🔐</span><strong>Login-Historie</strong><small>Anmeldungen im Überblick</small></a>
          <a class="security-hub-card" href="#geloeschte-anfragen"><span>🗑️</span><strong>Gelöschte Anfragen</strong><small>Archiv und Kontrolle</small></a>
        </div>
      </section>
    <% } %>

    <section id="login-historie" class="admin-panel security-section-card placeholder-security-panel" data-admin-page="sicherheit" hidden>
      <div class="department-section-head compact-head">
        <div>
          <p class="admin-kicker">Sicherheit</p>
          <h2>Login-Historie</h2>
          <p>Login-Ereignisse werden aktuell im Aktivitätsprotokoll erfasst.</p>
        </div>
        <a class="button secondary" href="#aktivitaetsprotokoll">Zum Aktivitätsprotokoll</a>
      </div>
    </section>

    <section id="geloeschte-anfragen" class="admin-panel security-section-card placeholder-security-panel" data-admin-page="sicherheit" hidden>
      <div class="department-section-head compact-head">
        <div>
          <p class="admin-kicker">Sicherheit</p>
          <h2>Gelöschte Anfragen</h2>
          <p>Gelöschte Anfragen werden über Backups und Aktivitätsprotokoll nachvollziehbar dokumentiert.</p>
        </div>
        <a class="button secondary" href="#backups">Backups öffnen</a>
      </div>
    </section>

    <% if (permissions && permissions.canDownloadBackups) { %>
    <section id="backups" class="admin-panel backup-panel security-section-card" data-admin-page="sicherheit" hidden>
      <div class="department-section-head compact-head">
        <div>
          <p class="admin-kicker">Datensicherung</p>
          <h2>Backups</h2>
          <p>Hier kannst du gespeicherte Sicherungen deiner Anfragen direkt herunterladen.</p>
        </div>
        <a class="button secondary" href="/admin/activity-log/download">Aktivitätsprotokoll herunterladen</a>
      </div>

      <% if (backups && backups.length) { %>
        <div class="backup-list">
          <% backups.forEach(backup => { %>
            <div class="backup-item">
              <div class="backup-file-info">
                <span class="backup-icon">💾</span>
                <div>
                  <strong><%= backup.file %></strong>
                  <span><%= backup.modifiedLabel %> · <%= backup.sizeKb %> KB</span>
                </div>
              </div>
              <a class="button" href="/admin/backups/<%= encodeURIComponent(backup.file) %>">Download</a>
            </div>
          <% }) %>
        </div>
      <% } else { %>
        <div class="backup-empty">
          <strong>Noch keine Backups vorhanden.</strong>
          <p>Backups entstehen automatisch, wenn Anfragen gespeichert, Status geändert oder Anfragen gelöscht werden.</p>
        </div>
      <% } %>
    </section>
    <% } %>


    <% if (permissions && permissions.canViewActivity && activityLog && activityLog.length) { %>
      <section id="aktivitaetsprotokoll" class="admin-panel activity-panel security-section-card" data-admin-page="sicherheit" hidden>
        <div class="department-section-head compact-head">
          <div>
            <p class="admin-kicker">Sicherheit</p>
            <h2>Letzte Aktivitäten</h2>
            <p>Login, Statusänderungen, Löschungen und Sicherheitsereignisse.</p>
          </div>
        </div>
        <div class="activity-list">
          <% activityLog.forEach(log => { %>
            <div class="activity-item">
              <div>
                <strong><%= log.action %></strong>
                <span><%= log.datum %> · <%= log.admin || 'System/Besucher' %></span>
              </div>
              <% if (log.details && Object.keys(log.details).length) { %>
                <small><%= Object.entries(log.details).map(([key, value]) => key + ': ' + value).join(' · ') %></small>
              <% } %>
            </div>
          <% }) %>
        </div>
      </section>
    <% } %>

  </main>
  <script>
    window.GRÜNWERK_STATUS_TEMPLATES = <%- JSON.stringify(statusTemplates) %>;
    window.GRÜNWERK_EMAIL_STATUSES = <%- JSON.stringify(emailStatusOptions) %>;

    document.querySelectorAll('[data-status-form]').forEach((form) => {
      const statusSelect = form.querySelector('[data-status-select]');
      const templateSelect = form.querySelector('[data-template-select]');
      const messageBox = form.querySelector('[data-message-box]');
      const notifyCheckbox = form.querySelector('[data-notify-checkbox]');
      const hint = form.querySelector('[data-email-hint]');
      const templates = window.GRÜNWERK_STATUS_TEMPLATES || {};
      const emailStatuses = new Set(window.GRÜNWERK_EMAIL_STATUSES || []);

      function updateTemplates() {
        const status = statusSelect.value;
        const list = templates[status] || [];
        templateSelect.innerHTML = '<option value="">Keine Vorlage</option>';
        list.forEach((template, index) => {
          const option = document.createElement('option');
          option.value = String(index);
          option.textContent = template.label;
          templateSelect.appendChild(option);
        });
      }

      function updateNotify() {
        const status = statusSelect.value;
        const shouldNotify = emailStatuses.has(status);
        notifyCheckbox.checked = shouldNotify;
        notifyCheckbox.disabled = !shouldNotify;
        hint.textContent = shouldNotify
          ? 'Bei diesem Status kann der Kunde automatisch informiert werden. Du kannst die E-Mail vor dem Senden anpassen.'
          : 'Dieser Status ist normalerweise intern. Es wird keine Kundenmail gesendet.';
      }

      statusSelect.addEventListener('change', () => {
        updateTemplates();
        updateNotify();
      });

      templateSelect.addEventListener('change', () => {
        const status = statusSelect.value;
        const selected = templates[status]?.[Number(templateSelect.value)];
        if (selected && !messageBox.value.trim()) {
          messageBox.value = selected.text;
        } else if (selected) {
          const replace = confirm('Vorlage in das Nachrichtenfeld übernehmen und den aktuellen Text ersetzen?');
          if (replace) messageBox.value = selected.text;
        }
      });

      updateTemplates();
      updateNotify();
    });


    function getInlineEditModal() {
      let modal = document.getElementById('inline-edit-modal');
      if (modal) return modal;

      modal = document.createElement('div');
      modal.id = 'inline-edit-modal';
      modal.className = 'inline-edit-modal';
      modal.innerHTML = `
        <div class="inline-edit-modal-backdrop" data-inline-edit-close="1"></div>
        <div class="inline-edit-modal-card" role="dialog" aria-modal="true" aria-labelledby="inline-edit-title">
          <button type="button" class="inline-edit-modal-close" data-inline-edit-close="1" aria-label="Schließen">×</button>
          <p class="admin-kicker">Auftragsfeld bearbeiten</p>
          <h3 id="inline-edit-title">Feld bearbeiten</h3>
          <label class="inline-edit-modal-label" for="inline-edit-value">Neuer Wert</label>
          <textarea id="inline-edit-value" class="inline-edit-modal-input" rows="4"></textarea>
          <div class="inline-edit-modal-actions">
            <button type="button" class="secondary inline-edit-cancel" data-inline-edit-close="1">Abbrechen</button>
            <button type="button" class="inline-edit-save">Speichern</button>
          </div>
        </div>
      `;
      document.body.appendChild(modal);

      modal.addEventListener('click', (event) => {
        if (event.target.matches('[data-inline-edit-close]')) {
          modal.classList.remove('is-open');
        }
      });

      document.addEventListener('keydown', (event) => {
        if (event.key === 'Escape') modal.classList.remove('is-open');
      });

      return modal;
    }

    document.addEventListener('click', (event) => {
      const button = event.target.closest('.inline-edit-pencil');
      if (!button) return;

      event.preventDefault();
      event.stopPropagation();

      const form = document.getElementById(button.dataset.editForm);
      if (!form) {
        alert('Bearbeitungsformular wurde nicht gefunden. Bitte Seite neu laden.');
        return;
      }

      const field = button.dataset.editField;
      const input = form.querySelector(`[name="${CSS.escape(field)}"]`);
      if (!input) {
        alert('Dieses Feld konnte nicht gefunden werden.');
        return;
      }

      const label = button.dataset.editLabel || field;
      const modal = getInlineEditModal();
      const title = modal.querySelector('#inline-edit-title');
      const textarea = modal.querySelector('#inline-edit-value');
      const saveButton = modal.querySelector('.inline-edit-save');
      const currentValue = input.value || button.dataset.editValue || '';

      title.textContent = `${label} bearbeiten`;
      textarea.value = currentValue;
      textarea.rows = button.dataset.editMultiline === 'true' ? 7 : 3;
      modal.classList.add('is-open');
      setTimeout(() => textarea.focus(), 20);

      saveButton.onclick = () => {
        input.value = textarea.value.trim();
        modal.classList.remove('is-open');
        if (typeof form.requestSubmit === 'function') {
          form.requestSubmit();
        } else {
          form.submit();
        }
      };
    }, true);


    document.querySelectorAll('[data-drag-request-id]').forEach((item) => {
      item.addEventListener('dragstart', (event) => {
        event.dataTransfer.setData('text/plain', item.dataset.dragRequestId);
        event.dataTransfer.effectAllowed = 'move';
      });
    });

    document.querySelectorAll('[data-drop-date][data-drop-time]').forEach((slot) => {
      slot.addEventListener('dragover', (event) => {
        if (!slot.classList.contains('slot-free')) return;
        event.preventDefault();
        slot.classList.add('slot-drop-hover');
      });
      slot.addEventListener('dragleave', () => slot.classList.remove('slot-drop-hover'));
      slot.addEventListener('drop', (event) => {
        event.preventDefault();
        slot.classList.remove('slot-drop-hover');
        if (!slot.classList.contains('slot-free')) return;
        const requestId = event.dataTransfer.getData('text/plain');
        if (!requestId) return;
        const form = document.createElement('form');
        form.method = 'POST';
        form.action = `/admin/calendar/${encodeURIComponent(requestId)}`;
        form.innerHTML = `
          <input type="hidden" name="_csrf" value="<%- csrfToken %>">
          <input type="hidden" name="calendarDate" value="${slot.dataset.dropDate}">
          <input type="hidden" name="calendarTime" value="${slot.dataset.dropTime}">
          <input type="hidden" name="calendarStatus" value="confirmed">
          <input type="hidden" name="calendarNote" value="Per Drag & Drop eingeplant">
        `;
        document.body.appendChild(form);
        form.submit();
      });
    });


    document.querySelectorAll('[data-sidebar-toggle]').forEach((button) => {
      button.addEventListener('click', () => {
        document.body.classList.toggle('sidebar-open');
      });
    });

    const adminPages = Array.from(document.querySelectorAll('[data-admin-page]'));
    const navLinks = Array.from(document.querySelectorAll('[data-nav-page]'));
    const securityHashes = new Set(['sicherheit', 'backups', 'aktivitaetsprotokoll', 'login-historie', 'geloeschte-anfragen']);

    function pageFromHash(hashValue) {
      const hash = String(hashValue || '').replace('#', '') || 'uebersicht';
      if (securityHashes.has(hash)) return 'sicherheit';
      if (hash === 'general-emails') return 'emails';
      if (hash.startsWith('dep-') || hash.startsWith('request-')) return 'anfragen';
      if (['uebersicht', 'anfragen', 'kalender', 'emails'].includes(hash)) return hash;
      return 'uebersicht';
    }

    function setActivePage(page, focusHash) {
      adminPages.forEach((section) => {
        section.hidden = section.dataset.adminPage !== page;
      });

      navLinks.forEach((link) => {
        const isActive = link.dataset.navPage === page;
        link.classList.toggle('active', isActive);
        if (link.closest('[data-security-nav]')) {
          link.closest('[data-security-nav]').classList.toggle('active', page === 'sicherheit');
        }
      });

      document.body.classList.remove('sidebar-open');

      if (focusHash) {
        const target = document.getElementById(focusHash.replace('#', ''));
        if (target && target.dataset.adminPage === page) {
          setTimeout(() => target.scrollIntoView({ behavior: 'smooth', block: 'start' }), 30);
        } else {
          window.scrollTo({ top: 0, behavior: 'smooth' });
        }
      } else {
        window.scrollTo({ top: 0, behavior: 'smooth' });
      }
    }

    function applyPageFromHash() {
      const hash = window.location.hash || '#uebersicht';
      setActivePage(pageFromHash(hash), hash);
    }

    navLinks.forEach((link) => {
      link.addEventListener('click', () => {
        const page = link.dataset.navPage || pageFromHash(link.getAttribute('href'));
        setActivePage(page, link.getAttribute('href'));
      });
    });

    window.addEventListener('hashchange', applyPageFromHash);
    applyPageFromHash();
  </script>

  <script>
    (function () {
      const securitySubPages = new Set(['backups', 'aktivitaetsprotokoll', 'login-historie', 'geloeschte-anfragen']);
      const primaryPages = new Set(['uebersicht', 'anfragen', 'kalender', 'emails', 'sicherheit']);

      function cleanHash(value) {
        return String(value || '').replace('#', '') || 'uebersicht';
      }

      function pageForTarget(target) {
        const clean = cleanHash(target);
        if (securitySubPages.has(clean) || clean === 'sicherheit') return 'sicherheit';
        if (clean === 'general-emails') return 'emails';
        if (clean.startsWith('dep-') || clean.startsWith('request-')) return 'anfragen';
        if (primaryPages.has(clean)) return clean;
        return 'uebersicht';
      }

      function showAdminPage(targetValue, shouldScroll) {
        const target = cleanHash(targetValue || window.location.hash);
        const page = pageForTarget(target);
        const sections = Array.from(document.querySelectorAll('[data-admin-page]'));

        sections.forEach((section) => {
          let visible = section.dataset.adminPage === page;

          if (page === 'sicherheit') {
            if (securitySubPages.has(target)) {
              visible = section.id === target;
            } else {
              visible = section.id === 'sicherheit';
            }
          }

          section.hidden = !visible;
        });

        document.querySelectorAll('[data-nav-page]').forEach((link) => {
          const active = link.dataset.navPage === page;
          link.classList.toggle('active', active);
          const securityGroup = link.closest('[data-security-nav]');
          if (securityGroup) securityGroup.classList.toggle('active', page === 'sicherheit');
        });

        document.querySelectorAll('.sidebar-subnav a').forEach((link) => {
          link.classList.toggle('active', cleanHash(link.getAttribute('href')) === target);
        });

        document.body.classList.remove('sidebar-open');

        if (shouldScroll) {
          const focus = document.getElementById(target);
          if (focus && !focus.hidden && (page !== 'sicherheit' || focus.id !== 'sicherheit')) {
            setTimeout(() => focus.scrollIntoView({ behavior: 'smooth', block: 'start' }), 30);
          } else {
            window.scrollTo({ top: 0, behavior: 'smooth' });
          }
        }
      }

      document.querySelectorAll('a[href^="#"]').forEach((link) => {
        const target = cleanHash(link.getAttribute('href'));
        if (!target) return;
        link.addEventListener('click', (event) => {
          const page = pageForTarget(target);
          if (!primaryPages.has(page)) return;
          event.preventDefault();
          if (window.location.hash === '#' + target) {
            showAdminPage(target, true);
          } else {
            window.location.hash = target;
          }
        });
      });

      window.addEventListener('hashchange', () => showAdminPage(window.location.hash, true));
      showAdminPage(window.location.hash || '#uebersicht', false);
      window.GRÜNWERK_SHOW_ADMIN_PAGE = showAdminPage;
    })();
  </script>
  <script src="/inline-edit.js" defer></script>
</body>
</html>
