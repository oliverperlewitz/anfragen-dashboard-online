<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GrünWerk Gartenbau</title>
  <link rel="stylesheet" href="/style.css">
</head>
<body>
  <div class="bg-orb orb-one"></div>
  <div class="bg-orb orb-two"></div>

  <header class="site-header">
    <a class="brand" href="#start" aria-label="GrünWerk Startseite">
      <span class="brand-icon">☘</span>
      <span>
        <strong>GrünWerk</strong>
        <small>Gartenbau</small>
      </span>
    </a>
    <nav>
      <a href="#leistungen">Leistungen</a>
      <a href="#preise">Preise</a>
      <a href="#projekte">Projekte</a>
      <a href="#kontakt">Kontakt</a>
      <a class="nav-button" href="#kontakt">Angebot anfragen</a>
    </nav>
  </header>

  <main id="start">
    <section class="hero section-pad">
      <div class="hero-text">
        <div class="eyebrow">🌿 Junges Gartenbau-Startup mit Stil, Qualität und Liebe zum Detail</div>
        <h1>Wir verwandeln Gärten in echte Wohlfühlorte.</h1>
        <p>Von der ersten Idee bis zur fertigen Außenanlage: GrünWerk verbindet frische Ideen, moderne Planung und echtes Handwerk.</p>
        <div class="hero-actions">
          <a class="button primary" href="#kontakt">Kostenlose Beratung →</a>
          <a class="button secondary" href="#projekte">Projekte ansehen</a>
        </div>
        <div class="stats">
          <div><strong>Startup</strong><span>Frische Ideen</span></div>
          <div><strong>100%</strong><span>Persönlich</span></div>
          <div><strong>4.9/5</strong><span>Kundenbewertung</span></div>
        </div>
      </div>
      <div class="hero-card">
        <img src="https://images.unsplash.com/photo-1558521958-0a228e77e984?auto=format&fit=crop&w=1300&q=80" alt="Eleganter Garten mit Terrasse und Pflanzen">
        <div class="hero-badge">★★★★★<br><strong>Exzellente Handwerksqualität</strong></div>
        <div class="image-caption"><span>Premium Gartenbau</span><strong>Natürlich. Modern. Zeitlos.</strong></div>
      </div>
    </section>

    <section id="leistungen" class="section-pad">
      <div class="section-title">
        <span>Unsere Leistungen</span>
        <h2>Alles für einen Garten, der begeistert.</h2>
        <p>Wir verbinden Kreativität, Fachwissen und präzises Handwerk zu Außenanlagen mit Charakter.</p>
      </div>
      <div class="cards four">
        <article><div class="icon">🌱</div><h3>Gartengestaltung</h3><p>Individuelle Gartenkonzepte mit Bepflanzung, Wegen, Sitzplätzen und natürlichen Formen.</p></article>
        <article><div class="icon">🧱</div><h3>Pflaster & Wege</h3><p>Terrassen, Gartenwege und Einfahrten mit hochwertigen Materialien und sauberer Ausführung.</p></article>
        <article><div class="icon">🌲</div><h3>Grünpflege</h3><p>Rasenpflege, Rückschnitt, Hecken, Beete und saisonale Pflege für gepflegte Außenanlagen.</p></article>
        <article><div class="icon">❄️</div><h3>Winterdienst</h3><p>Zuverlässiges Räumen und Streuen von Wegen, Einfahrten und Außenflächen im Winter.</p></article>
      </div>
    </section>

    <section id="preise" class="section-pad">
      <div class="section-title">
        <span>Dienstleistungen & Preise</span>
        <h2>Faire Preise für klare Leistungen.</h2>
        <p>Die Preise dienen als Orientierung. Ein genaues Angebot bekommst du nach kurzer Einschätzung oder Besichtigung.</p>
      </div>
      <div class="cards three price-grid">
        <article><h3>Gartenpflege Basis</h3><p>Ideal für kleinere Pflegearbeiten</p><strong>ab 39 € / Std.</strong><ul><li>Rasen mähen</li><li>Unkraut entfernen</li><li>Beete pflegen</li><li>Laub entfernen</li></ul></article>
        <article class="highlight"><h3>Gartenpflege Plus</h3><p>Beliebt für regelmäßige Pflege</p><strong>ab 49 € / Std.</strong><ul><li>Alle Basis-Leistungen</li><li>Hecken- und Strauchschnitt</li><li>Kanten schneiden</li><li>Pflegeplan nach Wunsch</li></ul></article>
        <article><h3>Gartengestaltung</h3><p>Für neue Projekte & Umgestaltung</p><strong>nach Angebot</strong><ul><li>Individuelle Planung</li><li>Beete & Pflanzenkonzept</li><li>Wege & kleine Pflasterflächen</li><li>Materialberatung</li></ul></article>
      </div>
    </section>

    <section id="projekte" class="section-pad dark-panel">
      <div class="section-title light">
        <span>Ausgewählte Projekte</span>
        <h2>Gärten mit Atmosphäre.</h2>
      </div>
      <div class="projects">
        <article style="background-image:url('https://images.unsplash.com/photo-1558904541-efa843a96f01?auto=format&fit=crop&w=1200&q=80')"><span>Privatgarten</span><h3>Moderner Familiengarten</h3></article>
        <article style="background-image:url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=80')"><span>Terrassenbau</span><h3>Elegante Naturstein-Terrasse</h3></article>
        <article style="background-image:url('https://images.unsplash.com/photo-1598902108854-10e335adac99?auto=format&fit=crop&w=1200&q=80')"><span>Gartendesign</span><h3>Grüne Wohlfühloase</h3></article>
      </div>
    </section>

    <section id="kontakt" class="section-pad contact-wrap">
      <% if (success) { %>
        <div class="success">Deine Anfrage wurde erfolgreich gesendet. Wir melden uns schnellstmöglich zurück.</div>
      <% } %>

      <div class="contact-card">
        <aside>
          <span>Kontakt</span>
          <h2>Bereit für deinen Traumgarten?</h2>
          <p>Schreib uns kurz, was du dir wünschst. Wir melden uns zeitnah mit einer persönlichen Beratung.</p>
          <div class="contact-info">
            <p>☎ +49 123 456789</p>
            <p>✉ oooperlewitz@gmail.com</p>
            <p>📍 Musterstraße 12, 12345 Gartenstadt</p>
          </div>
        </aside>

        <form action="/anfrage" method="POST" class="request-form" enctype="multipart/form-data">
          <div class="form-head">
            <span>Projektanfrage</span>
            <h3>Erzähl uns von deinem Auftrag</h3>
            <p>Je genauer deine Angaben sind, desto schneller können wir dir eine passende Einschätzung geben.</p>
          </div>

          <fieldset>
            <legend>1. Kontaktdaten</legend>
            <input name="name" placeholder="Name *" required>
            <input name="telefon" placeholder="Telefon *" required>
            <input name="email" type="email" placeholder="E-Mail-Adresse *" required>
            <input name="adresse" placeholder="Adresse / Ort des Auftrags">
          </fieldset>

          <fieldset>
            <legend>2. Worum geht es?</legend>
            <select name="leistung" required>
              <option value="">Gewünschte Leistung *</option>
              <option>Gartengestaltung</option>
              <option>Gartenpflege</option>
              <option>Rasen mähen</option>
              <option>Hecke schneiden</option>
              <option>Pflaster & Wege</option>
              <option>Winterdienst</option>
              <option>Sonstiges</option>
            </select>
            <select name="auftragsart">
              <option>Auftragsart</option>
              <option>Einmaliger Auftrag</option>
              <option>Regelmäßige Pflege</option>
              <option>Neues Projekt / Umgestaltung</option>
              <option>Dringender Auftrag</option>
            </select>
            <select name="groesse">
              <option>Grundstücksgröße</option>
              <option>Klein: bis 100 m²</option>
              <option>Mittel: 100–300 m²</option>
              <option>Groß: 300–700 m²</option>
              <option>Sehr groß: über 700 m²</option>
              <option>Weiß ich nicht genau</option>
            </select>
            <select name="zeitraum">
              <option>Gewünschter Zeitraum</option>
              <option>So schnell wie möglich</option>
              <option>Diese Woche</option>
              <option>Diesen Monat</option>
              <option>In den nächsten 2–3 Monaten</option>
              <option>Ich bin flexibel</option>
            </select>
          </fieldset>

          <fieldset class="full-fieldset">
            <legend>3. Details zum Auftrag</legend>
            <textarea name="details" placeholder="Beschreibe kurz, was gemacht werden soll..." required></textarea>
            <div class="money-field"><span>€</span><input name="budget" inputmode="decimal" placeholder="Ungefähres Budget, z. B. 500"></div>
            <select name="besichtigung">
              <option>Besichtigung gewünscht?</option>
              <option>Ja, gerne vor Ort</option>
              <option>Erst telefonisch besprechen</option>
              <option>Noch unsicher</option>
            </select>
          </fieldset>

          <fieldset class="full-fieldset appointment-fieldset">
            <legend>4. Wunschtermin</legend>
            <p class="field-help">Optional: Wähle einen freien Termin. Im Dashboard erscheint dieser Termin zuerst orange als möglicher Auftrag und wird von einem Admin bestätigt.</p>
            <div class="appointment-grid">
              <label>
                <span>Datum</span>
                <input type="date" name="wunschDatum" id="wunschDatum" min="">
              </label>
              <label>
                <span>Freie Uhrzeit</span>
                <select name="wunschUhrzeit" id="wunschUhrzeit" disabled>
                  <option value="">Bitte zuerst Datum wählen</option>
                </select>
              </label>
            </div>
            <p class="slot-hint" id="slotHint">Belegte Termine werden automatisch ausgeblendet.</p>
          </fieldset>

          <fieldset>
            <legend>5. Erreichbarkeit</legend>
            <select name="erreichbarkeit">
              <option>Am besten erreichbar</option>
              <option>Morgens</option>
              <option>Mittags</option>
              <option>Nachmittags</option>
              <option>Abends</option>
              <option>Jederzeit</option>
            </select>
            <select name="kontaktart">
              <option>Bevorzugte Kontaktart</option>
              <option>Telefon</option>
              <option>E-Mail</option>
              <option>WhatsApp</option>
            </select>
          </fieldset>


          <fieldset class="full-fieldset upload-fieldset">
            <legend>6. Fotos vom Einsatzort</legend>
            <p class="field-help">Optional: Lade bis zu 5 Bilder hoch, damit wir den Aufwand besser einschätzen können. Erlaubt sind JPG, PNG oder WEBP bis 10 MB pro Bild.</p>
            <input name="customerPhotos" type="file" accept="image/jpeg,image/png,image/webp" multiple>
          </fieldset>
          <label class="privacy">
            <input type="checkbox" name="datenschutz" value="ja" required>
            <span>Ich habe die Datenschutzerklärung gelesen und stimme zu, dass meine Angaben zur Bearbeitung der Anfrage verarbeitet werden.</span>
          </label>

          <button type="submit">Auftrag unverbindlich anfragen →</button>
          <p class="form-note">Kostenlos & unverbindlich — wir melden uns schnellstmöglich zurück.</p>
        </form>
      </div>
    </section>
  </main>

  <footer>
    <p>© 2026 GrünWerk Gartenbau. Alle Rechte vorbehalten.</p>
    <div><a href="#kontakt">Kontakt</a><a href="/admin">Admin</a></div>
  </footer>

  <script>
    const dateInput = document.getElementById('wunschDatum');
    const timeSelect = document.getElementById('wunschUhrzeit');
    const slotHint = document.getElementById('slotHint');

    // Feste Standard-Zeitfenster. Der Server prüft trotzdem nochmal,
    // ob der Termin wirklich frei ist, bevor die Anfrage gespeichert wird.
    const fallbackSlots = [
      '08:00', '09:00', '10:00', '11:00',
      '12:00', '13:00', '14:00', '15:00',
      '16:00', '17:00', '18:00'
    ];

    function setTimeOptions(slots, message) {
      timeSelect.innerHTML = '<option value="">Uhrzeit wählen</option>';

      let availableCount = 0;
      slots.forEach(slot => {
        const time = typeof slot === 'string' ? slot : slot.time;
        const available = typeof slot === 'string' ? true : slot.available !== false;
        if (!time) return;

        const option = document.createElement('option');
        option.value = available ? time : '';
        option.disabled = !available;
        option.textContent = available ? `${time} Uhr` : `${time} Uhr – belegt`;
        timeSelect.appendChild(option);
        if (available) availableCount += 1;
      });

      timeSelect.disabled = availableCount === 0;
      slotHint.textContent = message || (availableCount
        ? `${availableCount} freie Uhrzeiten an diesem Tag verfügbar.`
        : 'An diesem Tag sind keine freien Uhrzeiten mehr verfügbar. Bitte wähle ein anderes Datum.');
    }

    function resetTimeSelect() {
      timeSelect.innerHTML = '<option value="">Bitte zuerst Datum wählen</option>';
      timeSelect.disabled = true;
      slotHint.textContent = 'Belegte Termine werden automatisch ausgeblendet.';
    }

    if (dateInput && timeSelect) {
      const today = new Date();
      const yyyy = today.getFullYear();
      const mm = String(today.getMonth() + 1).padStart(2, '0');
      const dd = String(today.getDate()).padStart(2, '0');
      dateInput.min = `${yyyy}-${mm}-${dd}`;

      async function loadSlots() {
        const date = dateInput.value;
        if (!date) {
          resetTimeSelect();
          return;
        }

        timeSelect.innerHTML = '<option value="">Freie Uhrzeiten werden geladen...</option>';
        timeSelect.disabled = true;
        slotHint.textContent = 'Freie Uhrzeiten werden geprüft...';

        try {
          const response = await fetch(`/api/available-slots?date=${encodeURIComponent(date)}`, {
            headers: { 'Accept': 'application/json' }
          });

          if (!response.ok) throw new Error(`HTTP ${response.status}`);

          const data = await response.json();
          const slots = Array.isArray(data.slots) ? data.slots : [];

          if (!slots.length) {
            setTimeOptions(fallbackSlots, 'Keine Kalenderdaten gefunden. Bitte wähle eine Uhrzeit; der Termin wird beim Absenden nochmal geprüft.');
            return;
          }

          setTimeOptions(slots);
        } catch (error) {
          console.warn('Wunschtermin konnte nicht geladen werden:', error);
          setTimeOptions(fallbackSlots, 'Die freien Termine konnten gerade nicht geladen werden. Du kannst trotzdem eine Wunsch-Uhrzeit wählen; wir prüfen sie beim Absenden nochmal.');
        }
      }

      dateInput.addEventListener('change', loadSlots);
      dateInput.addEventListener('input', loadSlots);
      resetTimeSelect();

      // Falls der Browser/Autofill schon ein Datum gesetzt hat.
      if (dateInput.value) loadSlots();
    }
  </script>

</body>
</html>
