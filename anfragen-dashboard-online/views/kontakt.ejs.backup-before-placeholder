<!DOCTYPE html>
<html lang="de">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GrünWerk Gartenbau</title>
  <link rel="stylesheet" href="/style.css">
  <link rel="stylesheet" href="/wunschtermin.css">
  <link rel="stylesheet" href="/kontakt-clean.css">
</head>
<body>
  <div class="bg-orb orb-one"></div>
  <div class="bg-orb orb-two"></div>

  <header class="site-header">
    <a class="brand" href="#start" aria-label="GrünWerk Startseite">
      <span class="brand-icon">☘</span>
      <span>
        <strong>GrünWerk</strong>
        <small>Gartenbau</small>
      </span>
    </a>
    <nav>
      <a href="#leistungen">Leistungen</a>
      <a href="#preise">Preise</a>
      <a href="#projekte">Projekte</a>
      <a href="#kontakt">Kontakt</a>
      <a class="nav-button" href="#kontakt">Anfrage senden</a>
    </nav>
  </header>

  <main id="start">
    <section class="hero section-pad">
      <div class="hero-text">
        <div class="eyebrow">🌿 Gartenbau mit persönlicher Beratung und sauberer Ausführung</div>
        <h1>Wir verwandeln Gärten in echte Wohlfühlorte.</h1>
        <p>Von der ersten Idee bis zur fertigen Außenanlage: GrünWerk verbindet moderne Planung, ehrliche Beratung und zuverlässiges Handwerk.</p>
        <div class="hero-actions">
          <a class="button primary" href="#kontakt">Kostenlose Anfrage senden →</a>
          <a class="button secondary" href="#projekte">Projekte ansehen</a>
        </div>
        <div class="stats">
          <div><strong>Schnell</strong><span>Rückmeldung</span></div>
          <div><strong>Fair</strong><span>Unverbindlich</span></div>
          <div><strong>Regional</strong><span>Persönlich</span></div>
        </div>
      </div>
      <div class="hero-card">
        <img src="https://images.unsplash.com/photo-1558521958-0a228e77e984?auto=format&fit=crop&w=1300&q=80" alt="Eleganter Garten mit Terrasse und Pflanzen">
        <div class="hero-badge">★★★★★<br><strong>Saubere Arbeit & klare Absprachen</strong></div>
        <div class="image-caption"><span>GrünWerk Gartenbau</span><strong>Natürlich. Modern. Gepflegt.</strong></div>
      </div>
    </section>

    <section id="leistungen" class="section-pad">
      <div class="section-title">
        <span>Unsere Leistungen</span>
        <h2>Alles für einen Garten, der begeistert.</h2>
        <p>Wir verbinden Kreativität, Fachwissen und präzises Handwerk zu Außenanlagen mit Charakter.</p>
      </div>
      <div class="cards four">
        <article><div class="icon">🌱</div><h3>Gartengestaltung</h3><p>Individuelle Gartenkonzepte mit Bepflanzung, Wegen, Sitzplätzen und natürlichen Formen.</p></article>
        <article><div class="icon">🧱</div><h3>Pflaster & Wege</h3><p>Terrassen, Gartenwege und Einfahrten mit hochwertigen Materialien und sauberer Ausführung.</p></article>
        <article><div class="icon">🌲</div><h3>Gartenpflege</h3><p>Rasenpflege, Rückschnitt, Hecken, Beete und saisonale Pflege für gepflegte Außenanlagen.</p></article>
        <article><div class="icon">❄️</div><h3>Winterdienst</h3><p>Zuverlässiges Räumen und Streuen von Wegen, Einfahrten und Außenflächen im Winter.</p></article>
      </div>
    </section>

    <section id="preise" class="section-pad">
      <div class="section-title">
        <span>Dienstleistungen & Preise</span>
        <h2>Faire Preise für klare Leistungen.</h2>
        <p>Die Preise dienen als Orientierung. Ein genaues Angebot bekommst du nach kurzer Einschätzung oder Besichtigung.</p>
      </div>
      <div class="cards three price-grid">
        <article><h3>Gartenpflege Basis</h3><p>Ideal für kleinere Pflegearbeiten</p><strong>ab 39 € / Std.</strong><ul><li>Rasen mähen</li><li>Unkraut entfernen</li><li>Beete pflegen</li><li>Laub entfernen</li></ul></article>
        <article class="highlight"><h3>Gartenpflege Plus</h3><p>Beliebt für regelmäßige Pflege</p><strong>ab 49 € / Std.</strong><ul><li>Alle Basis-Leistungen</li><li>Hecken- und Strauchschnitt</li><li>Kanten schneiden</li><li>Pflegeplan nach Wunsch</li></ul></article>
        <article><h3>Gartengestaltung</h3><p>Für neue Projekte & Umgestaltung</p><strong>nach Angebot</strong><ul><li>Individuelle Planung</li><li>Beete & Pflanzenkonzept</li><li>Wege & kleine Pflasterflächen</li><li>Materialberatung</li></ul></article>
      </div>
    </section>

    <section id="projekte" class="section-pad dark-panel">
      <div class="section-title light">
        <span>Ausgewählte Projekte</span>
        <h2>Gärten mit Atmosphäre.</h2>
      </div>
      <div class="projects">
        <article style="background-image:url('https://images.unsplash.com/photo-1558904541-efa843a96f01?auto=format&fit=crop&w=1200&q=80')"><span>Privatgarten</span><h3>Moderner Familiengarten</h3></article>
        <article style="background-image:url('https://images.unsplash.com/photo-1600607687920-4e2a09cf159d?auto=format&fit=crop&w=1200&q=80')"><span>Terrassenbau</span><h3>Elegante Naturstein-Terrasse</h3></article>
        <article style="background-image:url('https://images.unsplash.com/photo-1598902108854-10e335adac99?auto=format&fit=crop&w=1200&q=80')"><span>Gartendesign</span><h3>Grüne Wohlfühloase</h3></article>
      </div>
    </section>

    <section id="kontakt" class="section-pad contact-wrap gw-contact-section">
      <% if (success) { %>
        <div class="success">Deine Anfrage wurde erfolgreich gesendet. Wir melden uns schnellstmöglich zurück.</div>
      <% } %>

      <div class="gw-contact-shell">
        <aside class="gw-contact-aside">
          <span class="gw-pill">Kontakt</span>
          <h2>Bereit für deinen Garten?</h2>
          <p>Beschreibe kurz dein Vorhaben. Wir melden uns zeitnah mit einer persönlichen Einschätzung.</p>
          <div class="gw-contact-info">
            <p><strong>Telefon</strong><span>+49 123 456789</span></p>
            <p><strong>E-Mail</strong><span>service@gruenwerk-gartenservice.de</span></p>
            <p><strong>Antworten</strong><span>Kundenmails landen direkt in unserem STRATO-Postfach und können ins Dashboard abgerufen werden.</span></p>
          </div>
          <div class="gw-trust-list">
            <span>✓ Kostenlos & unverbindlich</span>
            <span>✓ Schnelle Rückmeldung</span>
            <span>✓ Fotos optional möglich</span>
          </div>
        </aside>

        <form action="/anfrage" method="POST" class="gw-request-form" enctype="multipart/form-data">
          <div class="gw-form-head">
            <span>Projektanfrage</span>
            <h3>Erzähl uns kurz, was gemacht werden soll</h3>
            <p>Nur die wichtigsten Angaben sind Pflicht. Alles Weitere kannst du freiwillig ergänzen.</p>
          </div>

          <fieldset class="gw-fieldset">
            <legend>1. Kontakt</legend>
            <div class="gw-grid two">
              <input name="name" placeholder="Name *" required autocomplete="name">
              <input name="email" type="email" placeholder="E-Mail-Adresse *" required autocomplete="email">
              <input name="telefon" placeholder="Telefon / WhatsApp" autocomplete="tel">
              <input name="adresse" placeholder="Adresse / Ort des Auftrags" autocomplete="street-address">
            </div>
          </fieldset>

          <fieldset class="gw-fieldset">
            <legend>2. Auftrag</legend>
            <div class="gw-grid two">
              <select name="leistung" required>
                <option value="">Gewünschte Leistung *</option>
                <option>Gartengestaltung</option>
                <option>Gartenpflege</option>
                <option>Rasen mähen</option>
                <option>Hecke schneiden</option>
                <option>Pflaster & Wege</option>
                <option>Winterdienst</option>
                <option>Sonstiges</option>
              </select>
              <select name="auftragsart">
                <option value="">Auftragsart optional</option>
                <option>Einmaliger Auftrag</option>
                <option>Regelmäßige Pflege</option>
                <option>Neues Projekt / Umgestaltung</option>
                <option>Dringender Auftrag</option>
              </select>
            </div>
            <textarea name="details" placeholder="Kurz beschreiben, was gemacht werden soll *" required></textarea>
          </fieldset>

          <fieldset class="gw-fieldset gw-appointment-compact">
            <legend>3. Wunschtermin optional</legend>
            <p class="gw-help">Der Termin ist unverbindlich. Im Dashboard erscheint er zuerst orange und wird von uns bestätigt.</p>
            <div class="gw-appointment-row">
              <label class="gw-date-box">
                <span>Datum</span>
                <input type="date" name="wunschDatum" id="wunschDatum" min="">
              </label>
              <input type="hidden" name="wunschUhrzeit" id="wunschUhrzeit" value="">
              <div class="gw-time-box">
                <div class="gw-time-head"><span>Freie Uhrzeiten</span><small id="slotHint">Bitte Datum wählen.</small></div>
                <div class="slot-card-grid compact-slots" id="slotCards" aria-live="polite">
                  <div class="slot-empty">Nach der Datumsauswahl erscheinen hier freie Uhrzeiten.</div>
                </div>
              </div>
            </div>
          </fieldset>

          <fieldset class="gw-fieldset gw-upload-fieldset">
            <legend>4. Fotos optional</legend>
            <p class="gw-help">Bis zu 5 Bilder vom Einsatzort, max. 10 MB pro Bild. JPG, PNG oder WEBP.</p>
            <input name="customerPhotos" type="file" accept="image/jpeg,image/png,image/webp" multiple>
          </fieldset>

          <details class="gw-more-details">
            <summary>Weitere Angaben optional hinzufügen</summary>
            <fieldset class="gw-fieldset">
              <legend>Zusatzinfos</legend>
              <div class="gw-grid two">
                <div class="money-field"><span>€</span><input name="budget" inputmode="decimal" placeholder="Ungefähres Budget, z. B. 500"></div>
                <select name="groesse">
                  <option value="">Grundstücksgröße optional</option>
                  <option>Klein: bis 100 m²</option>
                  <option>Mittel: 100–300 m²</option>
                  <option>Groß: 300–700 m²</option>
                  <option>Sehr groß: über 700 m²</option>
                  <option>Weiß ich nicht genau</option>
                </select>
                <select name="zeitraum">
                  <option value="">Gewünschter Zeitraum optional</option>
                  <option>So schnell wie möglich</option>
                  <option>Diese Woche</option>
                  <option>Diesen Monat</option>
                  <option>In den nächsten 2–3 Monaten</option>
                  <option>Ich bin flexibel</option>
                </select>
                <select name="besichtigung">
                  <option value="">Besichtigung optional</option>
                  <option>Ja, gerne vor Ort</option>
                  <option>Erst telefonisch besprechen</option>
                  <option>Noch unsicher</option>
                </select>
                <select name="erreichbarkeit">
                  <option value="">Am besten erreichbar optional</option>
                  <option>Morgens</option>
                  <option>Mittags</option>
                  <option>Nachmittags</option>
                  <option>Abends</option>
                  <option>Jederzeit</option>
                </select>
                <select name="kontaktart">
                  <option value="">Bevorzugte Kontaktart optional</option>
                  <option>Telefon</option>
                  <option>E-Mail</option>
                  <option>WhatsApp</option>
                </select>
              </div>
            </fieldset>
          </details>

          <label class="gw-privacy">
            <input type="checkbox" name="datenschutz" value="ja" required>
            <span>Ich habe die Datenschutzerklärung gelesen und stimme zu, dass meine Angaben zur Bearbeitung der Anfrage verarbeitet werden.</span>
          </label>

          <button class="gw-submit" type="submit">Anfrage unverbindlich senden →</button>
          <p class="gw-form-note">Kostenlos & unverbindlich — wir melden uns schnellstmöglich zurück.</p>
        </form>
      </div>
    </section>
  </main>

  <footer>
    <p>© 2026 GrünWerk Gartenbau. Alle Rechte vorbehalten.</p>
    <div><a href="#kontakt">Kontakt</a><a href="/admin">Admin</a></div>
  </footer>

  <script src="/wunschtermin.js" defer></script>
</body>
</html>
